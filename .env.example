TEAMASSISTANT_IMAGE=ghcr.io/xunx-ii/teamassistant:latest
TEAMASSISTANT_HTTP_PORT=8080
TEAMASSISTANT_ADMIN_QQS=
TEAMASSISTANT_ADMIN_PASSWORD=
# 管理员登录有效期（小时，1-720），默认 168 小时（7 天）
TEAMASSISTANT_ADMIN_SESSION_TTL_HOURS=168
TEAMASSISTANT_MEMBER_SESSION_TTL_HOURS=168

# 正常部署默认启用 OpenQQ OneBot 机器人。
QQBOT_ENABLED=true
OPENQQ_WS_URL=ws://host.docker.internal:3001/
OPENQQ_ACCESS_TOKEN=
TEAMASSISTANT_BOT_TOKEN=
TEAMASSISTANT_QQ_GROUP_ID=1013228497
TEAMASSISTANT_GROUP_SYNC_INTERVAL_MS=60000

# 选择所用模型，或按 qqbot/.env.example 配置 CUSTOM_* 自定义模型。
PI_MODEL=
DEEPSEEK_API_KEY=
