TEAMASSISTANT_IMAGE=ghcr.io/xunx-ii/teamassistant:latest
TEAMASSISTANT_HTTP_PORT=8080
TEAMASSISTANT_ADMIN_QQS=
TEAMASSISTANT_ADMIN_PASSWORD=

# 正常部署默认启用机器人；扫码绑定时可以留空 AppID / AppSecret。
QQBOT_ENABLED=true
QQ_ENV=production
QQ_APP_ID=
QQ_APP_SECRET=

# 选择所用模型，或按 qqbot/.env.example 配置 CUSTOM_* 自定义模型。
PI_MODEL=
DEEPSEEK_API_KEY=
