# ===== QQ 机器人配置 =====

# 运行环境：production（正式）/ sandbox（沙箱，建议先在此测试）
QQ_ENV=sandbox

# QQ 凭据（优先于 credentials.json）
# 运行 `npm run bind` 扫码后会自动写入 credentials.json，一般无需手动配置
# QQ_APP_ID=
# QQ_APP_SECRET=

# 覆盖 QQ OpenAPI 域名（一般无需配置；QQ_ENV 会自动选择沙箱/正式域名）
# QQ_BASE_URL=https://api.sgroup.qq.com

# ===== pi 模型配置 =====

# 模型 API Key（按需填写你使用的 provider，pi 支持 anthropic/openai/deepseek/gemini 等）
ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# 指定模型（留空则 pi 自动选择可用模型）
# 格式：<provider>/<model-id>，例如
# PI_MODEL=anthropic/claude-sonnet-4-5
# PI_MODEL=deepseek/deepseek-chat
PI_MODEL=

# ===== 自定义模型（可选，不依赖内置运营商）=====
# 对接本地/自建服务（Ollama、vLLM、LM Studio、代理网关等），配置后自动生成 pi models.json
# 协议类型：openai-completions（最通用）/ openai-responses / anthropic-messages / google-generative-ai
# CUSTOM_BASE_URL=http://localhost:11434/v1
# CUSTOM_API=openai-completions
# CUSTOM_API_KEY=
# CUSTOM_MODEL=qwen2.5-coder:7b
# CUSTOM_NAME=           # 显示名（可选，默认同模型名）
# CUSTOM_CONTEXT=128000  # 上下文大小（tokens）
# CUSTOM_MAX_TOKENS=16384
# CUSTOM_IMAGES=false    # 是否支持图片输入
# CUSTOM_REASONING=false # 是否支持思考/推理
# CUSTOM_HEADERS={}      # 自定义请求头（JSON 对象，可选）

# 高级：直接指定已有 models.json 文件路径（支持多 provider 完全自定义，格式见 pi 文档 docs/models.md）
# 设置后 CUSTOM_* 系列配置被忽略
# PI_MODELS_FILE=./my-models.json

# ===== 团队报名（TeamAssistant 后端）=====

# 后端地址（api-v2 基础路径，见 docs/api-v2.md）
# TEAMASSISTANT_BASE_URL=http://127.0.0.1:23219/api/v2

# 门禁关闭时的邀请码（可选，门禁开放时无需配置）
# TEAMASSISTANT_INVITE_TOKEN=

# QQ 消息使用 markdown（需在 QQ 开放平台开通 markdown 消息权限）
# 开启后 /团队 <名称> 详情以表格渲染，其余消息也以 markdown 发送
# QQ_MARKDOWN=true

# ===== 机器人行为 =====

# 机器人人设提示词
BOT_PROMPT=你是一个乐于助人的 QQ 机器人，回答简洁友好。

# 工具白名单（逗号分隔，留空使用 pi 全部内置工具：read, bash, edit, write, grep, find, ls）
# 只读模式示例：BOT_TOOLS=read,grep,find,ls
# BOT_TOOLS=

# 重启恢复记忆时注入的历史消息条数上限
# BOT_HISTORY_LIMIT=20

# ===== 多用户流控（保护上游 API 并发上限）=====

# 上游 API 最大并发数：同时执行的生成请求数（超出按到达顺序排队）
# 建议按上游限制设置，如 DeepSeek/OpenAI 并发较低时设为 1-2
# BOT_MAX_CONCURRENCY=2

# 每个对话两次请求的最小间隔（秒），0 表示不限速（防止单用户刷屏）
# BOT_USER_RATE_LIMIT=3

# 排队等待上限（秒），超过则回复"机器人正忙"并放弃本次请求
# BOT_QUEUE_TIMEOUT=60

# 排队中的最大请求数，超过直接回复"机器人正忙"
# BOT_QUEUE_LIMIT=20
